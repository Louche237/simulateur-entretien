alue="Légende UML 2.5 &amp;amp; 2TUP" style="swimlane;startSize=28;fillColor=#ffffff;strokeColor=#cbd5e1;fontColor=#0f172a;rounded=1;fontStyle=1;fontSize=11;collapsible=0;shadow=1;" vertex="1" parent="1"><mxGeometry x="40" y="1460" width="240" height="220" as="geometry" /></mxCell><mxCell id="legend_text" value="&amp;lt;div style='font-size:10px; line-height:1.4;'&amp;gt;&amp;lt;b&amp;gt;Acteurs :&amp;lt;/b&amp;gt;&amp;lt;br&amp;gt;👤 Bleu : Acteurs Humains (Candidat)&amp;lt;br&amp;gt;👤 Violet : Administrateur Système&amp;lt;br&amp;gt;⚙️ Jaune : Systèmes Externes / APIs&amp;lt;br&amp;gt;&amp;lt;br&amp;gt;&amp;lt;b&amp;gt;Cas d'Utilisation :&amp;lt;/b&amp;gt;&amp;lt;br&amp;gt;🔵 Bleu : Fonctionnalités Candidat&amp;lt;br&amp;gt;🟣 Violet : Administration Système&amp;lt;br&amp;gt;&amp;lt;br&amp;gt;&amp;lt;b&amp;gt;Relations UML :&amp;lt;/b&amp;gt;&amp;lt;br&amp;gt;─── : Association directe&amp;lt;br&amp;gt;──▷ : Généralisation (Héritage)&amp;lt;br&amp;gt;--«include»-&amp;gt; : Dépendance obligatoire&amp;lt;br&amp;gt;--«extend»-&amp;gt; : Dépendance optionnelle&amp;lt;/div&amp;gt;" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=top;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="50" y="1495" width="220" height="175" as="geometry" /></mxCell></root></mxGraphModel></diagram></mxfile>