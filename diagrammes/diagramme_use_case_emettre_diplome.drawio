<mxfile host="app.diagrams.net" modified="2026-09-14T02:00:00.000Z" agent="Antigravity UML Generator" version="22.1.0" type="device"><diagram id="trustdiploma-uc-emettre-diplome" name="Diagramme Cas d'Utilisation - Émettre un diplôme (UML 2.5.1)"><mxGraphModel dx="1400" dy="950" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1300" pageHeight="880" background="#ffffff" math="0" shadow="0"><root><mxCell id="0" /><mxCell id="1" parent="0" /><mxCell id="boundary_dip" value="Système : Certification &amp;amp; Émission de Diplômes (TrustDiploma)" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#f8fafc;strokeColor=#2563eb;strokeWidth=2;verticalAlign=top;fontStyle=1;fontSize=15;fontFamily=Helvetica;fontColor=#0f172a;spacingTop=14;" vertex="1" parent="1"><mxGeometry x="220" y="40" width="810" height="780" as="geometry" /></mxCell><mxCell id="actor_univ" value="&lt;b&gt;Université&lt;/b&gt;&lt;br&gt;(Émetteur académique)" style="shape=umlActor;verticalLabelPosition=bottom;verticalAlign=top;html=1;outlineConnect=0;fillColor=#dbeafe;strokeColor=#1d4ed8;strokeWidth=2;fontFamily=Helvetica;fontSize=13;fontStyle=1;fontColor=#0f172a;" vertex="1" parent="1"><mxGeometry x="60" y="375" width="55" height="110" as="geometry" /></mxCell><mxCell id="actor_blockchain" value="&amp;laquo;system&amp;raquo;&lt;br&gt;&lt;b&gt;Réseau Blockchain&lt;/b&gt;&lt;br&gt;(Smart Contract)" style="shape=umlActor;verticalLabelPosition=bottom;verticalAlign=top;html=1;outlineConnect=0;fillColor=#fef3c7;strokeColor=#d97706;strokeWidth=2;fontFamily=Helvetica;fontSize=12;fontStyle=1;fontColor=#0f172a;" vertex="1" parent="1"><mxGeometry x="1100" y="240" width="55" height="110" as="geometry" /></mxCell><mxCell id="actor_sgbd" value="&amp;laquo;system&amp;raquo;&lt;br&gt;&lt;b&gt;SGBD&lt;/b&gt;&lt;br&gt;(Base de données)" style="shape=umlActor;verticalLabelPosition=bottom;verticalAlign=top;html=1;outlineConnect=0;fillColor=#fef3c7;strokeColor=#d97706;strokeWidth=2;fontFamily=Helvetica;fontSize=12;fontStyle=1;fontColor=#0f172a;" vertex="1" parent="1"><mxGeometry x="1100" y="500" width="55" height="110" as="geometry" /></mxCell><mxCell id="uc_main_dip" value="&lt;b&gt;Émettre un diplôme&lt;/b&gt;&lt;br&gt;&lt;font style='font-size:10px;'&gt;(Certification numérique)&lt;/font&gt;" style="ellipse;whiteSpace=wrap;html=1;fillColor=#1d4ed8;strokeColor=#1e40af;strokeWidth=2.5;fontFamily=Helvetica;fontSize=13;fontStyle=1;fontColor=#ffffff;align=center;" vertex="1" parent="1"><mxGeometry x="510" y="375" width="215" height="95" as="geometry" /></mxCell><mxCell id="uc_upload" value="&lt;b&gt;Téléverser &amp;amp; analyser&lt;br&gt;le PDF du diplôme&lt;/b&gt;&lt;br&gt;&lt;font style='font-size:10px;'&gt;(msg 3, 4)&lt;/font&gt;" style="ellipse;whiteSpace=wrap;html=1;fillColor=#ecfdf5;strokeColor=#059669;strokeWidth=1.8;fontFamily=Helvetica;fontSize=12;fontStyle=1;fontColor=#065f46;align=center;" vertex="1" parent="1"><mxGeometry x="520" y="115" width="195" height="70" as="geometry" /></mxCell><mxCell id="uc_extract" value="&lt;b&gt;Extraire les données&lt;br&gt;académiques&lt;/b&gt;&lt;br&gt;&lt;font style='font-size:10px;'&gt;(Matricule, Nom, Filière - msg 7)&lt;/font&gt;" style="ellipse;whiteSpace=wrap;html=1;fillColor=#ecfdf5;strokeColor=#059669;strokeWidth=1.8;fontFamily=Helvetica;fontSize=12;fontStyle=1;fontColor=#065f46;align=center;" vertex="1" parent="1"><mxGeometry x="290" y="160" width="195" height="75" as="geometry" /></mxCell><mxCell id="uc_hash" value="&lt;b&gt;Créer l'empreinte&lt;br&gt;numérique (Hash SHA-256)&lt;/b&gt;&lt;br&gt;&lt;font style='font-size:10px;'&gt;(msg 10)&lt;/font&gt;" style="ellipse;whiteSpace=wrap;html=1;fillColor=#ecfdf5;strokeColor=#059669;strokeWidth=1.8;fontFamily=Helvetica;fontSize=12;fontStyle=1;fontColor=#065f46;align=center;" vertex="1" parent="1"><mxGeometry x="745" y="160" width="195" height="70" as="geometry" /></mxCell><mxCell id="uc_bc_send" value="&lt;b&gt;Ancrer l'empreinte&lt;br&gt;sur la Blockchain&lt;/b&gt;&lt;br&gt;&lt;font style='font-size:10px;'&gt;(msg 12)&lt;/font&gt;" style="ellipse;whiteSpace=wrap;html=1;fillColor=#ecfdf5;strokeColor=#059669;strokeWidth=1.8;fontFamily=Helvetica;fontSize=12;fontStyle=1;fontColor=#065f46;align=center;" vertex="1" parent="1"><mxGeometry x="775" y="290" width="190" height="75" as="geometry" /></mxCell><mxCell id="uc_db_save" value="&lt;b&gt;Sauvegarder le diplôme&lt;br&gt;en base de données&lt;/b&gt;&lt;br&gt;&lt;font style='font-size:10px;'&gt;(msg 14, 15)&lt;/font&gt;" style="ellipse;whiteSpace=wrap;html=1;fillColor=#ecfdf5;strokeColor=#059669;strokeWidth=1.8;fontFamily=Helvetica;fontSize=12;fontStyle=1;fontColor=#065f46;align=center;" vertex="1" parent="1"><mxGeometry x="775" y="520" width="190" height="70" as="geometry" /></mxCell><mxCell id="uc_err_pdf" value="Gérer erreur PDF&lt;br&gt;(Corrompu ou illisible)&lt;br&gt;&lt;font style='font-size:10px;'&gt;(msg 5, 6)&lt;/font&gt;" style="ellipse;whiteSpace=wrap;html=1;fillColor=#fff1f2;strokeColor=#e11d48;strokeWidth=1.5;fontFamily=Helvetica;fontSize=12;fontStyle=0;fontColor=#9f1239;align=center;" vertex="1" parent="1"><mxGeometry x="280" y="275" width="180" height="70" as="geometry" /></mxCell><mxCell id="uc_err_data" value="Gérer données&lt;br&gt;manquantes&lt;br&gt;&lt;font style='font-size:10px;'&gt;(msg 8, 9)&lt;/font&gt;" style="ellipse;whiteSpace=wrap;html=1;fillColor=#fff1f2;strokeColor=#e11d48;strokeWidth=1.5;fontFamily=Helvetica;fontSize=12;fontStyle=0;fontColor=#9f1239;align=center;" vertex="1" parent="1"><mxGeometry x="280" y="490" width="180" height="70" as="geometry" /></mxCell><mxCell id="uc_buffer_bc" value="Mettre en attente&lt;br&gt;(Blockchain indisponible)&lt;br&gt;&lt;font style='font-size:10px;'&gt;(msg 11, 13)&lt;/font&gt;" style="ellipse;whiteSpace=wrap;html=1;fillColor=#fff1f2;strokeColor=#e11d48;strokeWidth=1.5;fontFamily=Helvetica;fontSize=12;fontStyle=0;fontColor=#9f1239;align=center;" vertex="1" parent="1"><mxGeometr