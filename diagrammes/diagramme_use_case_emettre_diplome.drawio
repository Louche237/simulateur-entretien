source="uc_main_dip" target="uc_bc_send"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="inc_db" value="&amp;laquo;include&amp;raquo;" style="endArrow=open;endSize=10;dashed=1;html=1;strokeWidth=1.5;strokeColor=#059669;fontFamily=Helvetica;fontSize=11;fontStyle=2;fontColor=#065f46;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="uc_main_dip" target="uc_db_save"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="ext_err_pdf" value="&amp;laquo;extend&amp;raquo;" style="endArrow=open;endSize=10;dashed=1;html=1;strokeWidth=1.5;strokeColor=#e11d48;fontFamily=Helvetica;fontSize=11;fontStyle=2;fontColor=#be123c;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="uc_err_pdf" target="uc_main_dip"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="ext_err_data" value="&amp;laquo;extend&amp;raquo;" style="endArrow=open;endSize=10;dashed=1;html=1;strokeWidth=1.5;strokeColor=#e11d48;fontFamily=Helvetica;fontSize=11;fontStyle=2;fontColor=#be123c;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="uc_err_data" target="uc_main_dip"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="ext_buffer" value="&amp;laquo;extend&amp;raquo;" style="endArrow=open;endSize=10;dashed=1;html=1;strokeWidth=1.5;strokeColor=#e11d48;fontFamily=Helvetica;fontSize=11;fontStyle=2;fontColor=#be123c;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="uc_buffer_bc" target="uc_main_dip"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="legend_box_dip" value="&lt;b&gt;Correspondance avec le diagramme de communication :&lt;/b&gt;&lt;br&gt;• &lt;b&gt;&amp;laquo;include&amp;raquo;&lt;/b&gt; : Scénario nominal obligatoire (Upload &amp;rarr; Extraction &amp;rarr; Hash &amp;rarr; Blockchain &amp;rarr; SGBD).&lt;br&gt;• &lt;b&gt;&amp;laquo;extend&amp;raquo;&lt;/b&gt; : Scénarios alternatifs/exceptions (PDF corrompu msg 5, Données absentes msg 8, Blockchain offline msg 11)." style="shape=note;whiteSpace=wrap;html=1;size=14;verticalAlign=top;align=left;spacingLeft=10;spacingTop=6;fillColor=#f1f5f9;strokeColor=#94a3b8;fontSize=10;fontFamily=Helvetica;fontColor=#334155;" vertex="1" parent="1"><mxGeometry x="250" y="715" width="570" height="75" as="geometry" /></mxCell></root></mxGraphModel></diagram></mxfile>