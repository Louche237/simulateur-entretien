# Email & SMTP (Confirmation d'inscription & Notifications)
# Note : Si SMTP_USER et SMTP_PASS sont vides, le mode simulation est actif (les liens s'affichent dans la console backend).
#
# Exemple 1 : Gmail (avec un Mot de passe d'application généré sur Google)
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_SECURE=false
# SMTP_USER=votre-adresse@gmail.com
# SMTP_PASS=abcd efgh ijkl mnop
# EMAIL_FROM="JobMentor <votre-adresse@gmail.com>"
#
# Exemple 2 : Brevo (ex-Sendinblue, 300 mails/jour gratuits)
# SMTP_HOST=smtp-relay.brevo.com
# SMTP_PORT=587
# SMTP_SECURE=false
# SMTP_USER=votre-login-brevo
# SMTP_PASS=votre-cle-smtp-brevo
# EMAIL_FROM="JobMentor <contact@votredomaine.fr>"
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
EMAIL_FROM="JobMentor <noreply@jobmentor.fr>"

